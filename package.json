{
	"name": "@toreda/build-tools",
	"version": "1.0.0",
	"description": "",
	"main": "./dist/cjs/index.js",
	"module": "./dist/esm/index.js",
	"typings": "./dist/cjs/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/esm/index.d.ts",
				"default": "./dist/esm/index.js"
			},
			"require": {
				"types": "./dist/cjs/index.d.ts",
				"default": "./dist/cjs/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"directories": {
		"test": "tests"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "cross-env COVERAGE=full jest --coverage",
		"test:ci": "cross-env COVERAGE=full jest --ci --coverage --maxWorkers=50% --reporters=default --reporters=jest-junit",
		"test:fast": "cross-env COVERAGE=summary jest --bail --coverage",
		"lint": "pnpm lint:nofix",
		"lint:nofix": "pnpm eslint src/**.{js,ts} --quiet",
		"lint:fix": "pnpm eslint src/**/*.{js,ts,tsx} --quiet --fix",
		"build": "pnpm lint && pnpm gulp --preload ts-node/register",
		"make:docs": "pnpm typedoc docs --categorizeByGroup false --entryPoints ./src/index.ts"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/toreda/build-tools.git"
	},
	"keywords": [
		"build",
		"build package",
		"buildscript",
		"gulp-eslint alternative",
		"gulp",
		"lightweight",
		"toreda",
		"typescript"
	],
	"author": "Toreda, Inc.",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/toreda/build-tools/issues"
	},
	"homepage": "https://github.com/toreda/build-tools#readme",
	"dependencies": {
		"@toreda/log": "^1.0.0",
		"@toreda/shared-types": "^3.0.0",
		"fs-extra": "^11.4.0",
		"gulp-nunjucks-render": "^2.2.3",
		"gulp-sourcemaps": "^3.0.0",
		"gulp-typescript": "6.0.0-alpha.1",
		"merge-stream": "^2.0.0",
		"yargs": "^17.7.2"
	},
	"peerDependencies": {
		"eslint": "^10.0.0",
		"gulp": "^5.0.0",
		"jest": "^30.0.0",
		"typescript": ">=6.0.0 <7.0.0",
		"webpack": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"jest": {
			"optional": true
		}
	},
	"prettier": "@toreda/prettier-config",
	"devDependencies": {
		"@stylistic/eslint-plugin": "^5.10.0",
		"@swc/core": "^1.16.2",
		"@swc/jest": "^0.2.39",
		"@toreda/eslint-config": "^4.0.0",
		"@toreda/prettier-config": "^2.0.0",
		"@types/fs-extra": "^11.0.4",
		"@types/gulp": "^4.0.18",
		"@types/gulp-sourcemaps": "^0.0.35",
		"@types/jest": "^30.0.0",
		"@types/merge-stream": "^2.0.0",
		"@types/mock-fs": "^4.13.4",
		"@types/node": "^26.6.1",
		"@types/webpack": "^5.28.5",
		"@types/yargs": "^17.0.35",
		"canvas": "^3.2.3",
		"cross-env": "^10.1.0",
		"del": "^6.1.1",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"gulp": "^5.0.1",
		"jest": "^30.5.2",
		"jsdom": "^30.1.0",
		"mock-fs": "^5.5.0",
		"prettier": "^3.9.8",
		"ts-node": "^10.9.2",
		"typedoc": "^0.28.20",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.3",
		"utf-8-validate": "^6.0.6",
		"webpack": "^5.111.1"
	}
}
